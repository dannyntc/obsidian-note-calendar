{
	"name": "obsidian-note-calendar",
	"version": "0.3.0",
	"description": "Add a month calendar to an Obsidian note and link dated entries back to it.",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "node esbuild.config.mjs --production",
		"dev": "node esbuild.config.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsc -p tests/tsconfig.json && node --test .test-build/tests/*.test.js",
		"package": "npm run build && node tools/package-release.mjs"
	},
	"devDependencies": {
		"@types/node": "22.10.2",
		"esbuild": "0.25.9",
		"typescript": "5.7.3"
	}
}
